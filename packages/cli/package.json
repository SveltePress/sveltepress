{
  "name": "@sveltepress/cli",
  "type": "module",
  "version": "0.2.1",
  "packageManager": "pnpm@10.34.5",
  "description": "Document version management CLI for SveltePress",
  "license": "MIT",
  "homepage": "https://sveltepress.site/",
  "repository": {
    "type": "github",
    "url": "https://github.com/SveltePress/sveltepress",
    "directory": "packages/cli"
  },
  "exports": {
    ".": "./dist/index.mjs"
  },
  "types": "./dist/index.d.ts",
  "bin": {
